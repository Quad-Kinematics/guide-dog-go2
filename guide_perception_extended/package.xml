<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_perception_extended</name>
  <version>0.1.0</version>
  <description>
    Face recognition for the Unitree Go2 guide robot pipeline. Subscribes to a
    camera image topic (once an upstream LiDAR + head-pointing system has
    aimed the camera at the closest person), detects and identifies the most
    relevant face using InsightFace, and publishes the result as JSON on
    /recognized_person for downstream decision-making nodes.
  </description>
  <maintainer email="claudecodeshared67@gmail.com">oxy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- The standalone face_recognition.launch.py brings up the RealSense driver
       and is started via `ros2 launch`. -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
