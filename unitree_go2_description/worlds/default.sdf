<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- Geographic origin for GPS simulation -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.0444</latitude_deg>
      <longitude_deg>31.2357</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    
    <!-- Lights -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Box 1 -->
    <model name="box1">
      <pose>5 0 0.5 0 0 0</pose>
      <link name="box_link">
        <collision name="box_collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box_visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <!-- Box 2 -->
    <model name="box2">
      <pose>-3 4 0.5 0 0 0.5</pose>
      <link name="box_link">
        <collision name="box_collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box_visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <!-- Box 3 -->
    <model name="box3">
      <pose>0 -5 0.5 0 0 0.7</pose>
      <link name="box_link">
        <collision name="box_collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box_visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <!-- Cylinder 1 -->
    <model name="cylinder1">
      <pose>3 3 0.5 0 0 0</pose>
      <link name="cylinder_link">
        <collision name="cylinder_collision"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="cylinder_visual">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>
    
    <!-- Cylinder 2 -->
    <model name="cylinder2">
      <pose>-4 -3 0.5 0 0 0</pose>
      <link name="cylinder_link">
        <collision name="cylinder_collision"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="cylinder_visual">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0 1 1 1</ambient><diffuse>0 1 1 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <!-- Actor 1: Walks along the X axis -->
    <actor name="walking_person_1">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>0 2 0 0 0 0</pose></waypoint>
          <waypoint><time>4</time><pose>4 2 0 0 0 0</pose></waypoint>
          <waypoint><time>4.5</time><pose>4 2 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>8.5</time><pose>0 2 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>9</time><pose>0 2 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 2: Walks along the Y axis -->
    <actor name="walking_person_2">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>1.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>-1 -2 0 0 0 1.5707</pose></waypoint>
          <waypoint><time>4</time><pose>-1 2 0 0 0 1.5707</pose></waypoint>
          <waypoint><time>4.5</time><pose>-1 2 0 0 0 -1.5707</pose></waypoint>
          <waypoint><time>8.5</time><pose>-1 -2 0 0 0 -1.5707</pose></waypoint>
          <waypoint><time>9</time><pose>-1 -2 0 0 0 1.5707</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 3: Walks back and forth near the bottom edge -->
    <actor name="walking_person_3">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person/tip/files/meshes/walking.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start> 
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>2 -3 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>4</time><pose>-2 -3 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>4.5</time><pose>-2 -3 0 0 0 0</pose></waypoint>
          <waypoint><time>8.5</time><pose>2 -3 0 0 0 0</pose></waypoint>
          <waypoint><time>9</time><pose>2 -3 0 0 0 3.14159</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>