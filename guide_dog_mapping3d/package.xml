<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_dog_mapping3d</name>
  <version>0.0.0</version>
  <description>3D point cloud map from the Go2's built-in L1 LiDAR, for viewing (not used by navigation)</description>
  <maintainer email="unitree@todo.todo">unitree</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>guide_dog_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
